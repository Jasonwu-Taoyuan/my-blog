generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  posts     Post[]
}

model Post {
  id                 String    @id @default(cuid())
  title              String
  slug               String    @unique
  summary            String
  content            String
  coverImageUrl      String?
  tags               String
  category           String?
  status             String    @default("draft")
  publishedAt        DateTime?
  readingTimeMinutes Int       @default(5)
  authorId           String
  author             User      @relation(fields: [authorId], references: [id])
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([slug])
  @@index([status])
  @@index([publishedAt])
}

model Photo {
  id          String    @id @default(cuid())
  title       String?
  imageUrl    String
  album       String?
  description String?
  takenAt     DateTime?
  linkUrl     String?
  createdAt   DateTime  @default(now())

  @@index([album])
}

model About {
  id          String   @id @default(cuid())
  displayName String
  headline    String
  bioMarkdown String
  links       String
  experience  String?
  skills      String?
  updatedAt   DateTime @updatedAt
}

model MindMap {
  id        String   @id @default(cuid())
  title     String
  bookTitle String?
  bookId    String?
  data      String   // JSON: mind-elixir NodeData
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookId])
}

model Trip {
  id            String    @id @default(cuid())
  placeName     String
  country       String?
  lat           Float
  lng           Float
  visitedAt     DateTime?
  note          String?
  coverImageUrl String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([country])
}

model HiddenBook {
  id        String   @id @default(cuid())
  notionId  String   @unique
  createdAt DateTime @default(now())
}

model BookReview {
  id        String   @id @default(cuid())
  notionId  String   @unique
  rating    Int?
  summary   String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
// ── 讀書清單知識圖譜 ─────────────────────────────────────
// AI 為每本書抽出的核心概念；共用概念的書會在圖譜上連在一起
model BookConcept {
  id        String   @id @default(cuid())
  notionId  String
  concept   String
  createdAt DateTime @default(now())

  @@unique([notionId, concept])
  @@index([concept])
}

// 已處理過的書（含抽不出概念的），用來接續處理新書
model BookGraphProcessed {
  notionId    String   @id
  title       String
  processedAt DateTime @default(now())
}
